NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/restaurant_app
JWT_SECRET=replace-with-a-long-development-secret
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
PUBLIC_APP_URL=http://localhost:5173

# Where this API is reachable from outside. Better Auth builds its OAuth callback
# URLs from this, so it must match what Google and Apple are configured with.
PUBLIC_API_URL=http://localhost:3000

# Customer accounts (Better Auth). Falls back to JWT_SECRET when left unset.
BETTER_AUTH_SECRET=replace-with-another-long-development-secret

# Social sign-in. A provider is only switched on when both of its values are
# filled in, so leaving these blank runs email and password login on its own.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=
SEED_ADMIN_EMAIL=admin@spisnem.dk
SEED_ADMIN_PASSWORD=development-password
